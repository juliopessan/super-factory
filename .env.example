# Opcional. Sem chave de modelo, a mesa local responde com o quadro e as ferramentas.
# Com uma chave, os agentes usam o modelo correspondente.
# SUPER_FACTORY_MODEL=openai/gpt-6.1-terra
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Sem estes valores, GitHub e Azure DevOps ficam em modo simulado.
# A Factory avisa no resultado e não finge que abriu um item de verdade.
# GITHUB_TOKEN=
# AZURE_DEVOPS_ORG=
# AZURE_DEVOPS_PROJECT=
# AZURE_DEVOPS_PAT=

# Por padrão, a Factory só abre neste computador (localhost), porque o Studio
# não tem login. Para abrir para outras máquinas da rede, de propósito:
# SUPER_FACTORY_HOST=0.0.0.0

# Modo autônomo (workflow autonomo): a Factory clona o repositório num container
# Docker, implementa, roda os testes do repositório e abre o pull request.
# Precisa do Docker rodando (Docker Desktop, Colima ou Docker Engine), de
# ANTHROPIC_API_KEY e de GITHUB_TOKEN ou AZURE_DEVOPS_ORG + AZURE_DEVOPS_PAT
# com permissão de escrita em branch. O merge continua com uma pessoa.
# SUPER_FACTORY_BUILDER_MODEL=anthropic/claude-sonnet-5-5
# SUPER_FACTORY_SANDBOX_IMAGE=node:22-bookworm
# SUPER_FACTORY_SANDBOX_NETWORK=
# Com Colima no Mac, aponte para o socket dele (troque SEU_USUARIO por whoami).
# Com Docker Desktop, deixe comentado.
# DOCKER_HOST=unix:///Users/SEU_USUARIO/.colima/default/docker.sock

# Chaves salvas pelo painel (botão "Chaves e acessos" no Studio) ficam criptografadas em disco.
# Esta é a chave mestra da criptografia. O instalador da VPS gera uma sozinho.
# Para gerar uma: openssl rand -base64 32
# Sem ela, a Factory cria um arquivo de chave ao lado do cofre (menos seguro).
# SUPER_FACTORY_MASTER_KEY=
