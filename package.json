{
  "name": "super-factory",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "MASTRA_AUTO_DETECT_URL=true mastra dev --dir src/super-factory",
    "build": "mastra build --dir src/super-factory",
    "start": "MASTRA_AUTO_DETECT_URL=true mastra start",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node --experimental-strip-types src/scripts/check.ts",
    "e2e": "node --experimental-strip-types src/scripts/e2e.ts",
    "limpar-segredos": "node --experimental-strip-types src/scripts/limpar-segredos.ts"
  },
  "dependencies": {
    "@mastra/core": "^1.82.0",
    "@mastra/libsql": "^1.29.0",
    "@mastra/mcp": "^2.8.0",
    "@mastra/memory": "^1.41.0",
    "@mastra/observability": "^1.23.1",
    "@mastra/server": "^1.82.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "mastra": "^1.38.0",
    "typescript": "^7.0.2"
  }
}
